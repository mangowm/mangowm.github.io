{
  "name": "mao",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "secrets": {
    "required": ["DISCORD_PUBLIC_KEY", "DISCORD_BOT_TOKEN", "GATEWAY_SECRET"],
  },
  "durable_objects": {
    "bindings": [{ "name": "GATEWAY", "class_name": "Gateway" }],
  },
  "exports": {
    "Gateway": { "type": "durable-object", "storage": "sqlite" },
  },
}
