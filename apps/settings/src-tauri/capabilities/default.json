{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:allow-exists",
    "fs:allow-read-dir",
    "fs:allow-copy-file",
    "fs:allow-mkdir",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "mmsg", "cmd": "mmsg", "args": ["dispatch", "reload_config"], "sidecar": false }
      ]
    },
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/.config/mango" },
        { "path": "$HOME/.config/mango/**/*" },
        { "path": "$HOME/.config/mango/**/.*" }
      ]
    }
  ]
}
