{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$HOME/.config/mango/config.conf" }]
    }
  ]
}
